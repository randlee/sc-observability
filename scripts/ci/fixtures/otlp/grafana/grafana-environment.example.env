# Grafana D9 configuration references.  Values are intentionally absent: use
# the approved local secret store / protected CI environment, never this file.
# The probe resolves only the names below and never prints their values.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana Cloud direct ingest contract: this harness accepts http/protobuf only.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
SC_OBS_GRAFANA_URL=
SC_OBS_GRAFANA_LOGS_QUERY_URL=
SC_OBS_GRAFANA_TRACES_QUERY_URL=
SC_OBS_GRAFANA_METRICS_QUERY_URL=
SC_OBS_GRAFANA_LOGS_AUTH_ENV=SC_OBS_GRAFANA_LOGS_AUTH
SC_OBS_GRAFANA_TRACES_AUTH_ENV=SC_OBS_GRAFANA_TRACES_AUTH
SC_OBS_GRAFANA_METRICS_AUTH_ENV=SC_OBS_GRAFANA_METRICS_AUTH
