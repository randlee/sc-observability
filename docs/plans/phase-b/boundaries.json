{
  "format_version": 1,
  "phase": "B",
  "status": "proposed",
  "implementation_status": "not_implemented",
  "authority": "Each contract document supplies complete declarations; this manifest defines boundary ownership, transport and result rules without changing those declarations.",
  "boundaries": [
    {
      "id": "runtime_level",
      "implementation_owner": "B.P1",
      "contract": "docs/plans/phase-b/runtime-level-contract.md",
      "transport": "native_rust",
      "operations": [
        "try_log_with_outcome",
        "new_with_level_owner",
        "build_with_level_owner",
        "level_state",
        "elevate_level",
        "reset_level"
      ],
      "result_contract": "Rust Result for fallible operations; infallible state snapshot",
      "invariants": [
        "owner_only_mutation",
        "immutable_configured_baseline",
        "accepted_or_filtered",
        "weak_owner_does_not_retain_writer"
      ]
    },
    {
      "id": "bridge",
      "implementation_owner": "B.P3",
      "contract": "docs/plans/phase-b/target-bridge-api.md",
      "transport": "native_rust",
      "operations": [
        "init",
        "try_log",
        "query",
        "health",
        "flush",
        "shutdown",
        "wait_stopped",
        "elevate_level",
        "reset_level"
      ],
      "result_contract": "Native signatures and complete export inventory in target contract",
      "invariants": [
        "BTIT_implementation_before_B1_copy",
        "single_lifecycle_owner",
        "one_inflight_flush",
        "shutdown_late_result_retained",
        "EmitOutcome_aliases_core_AdmissionOutcome"
      ]
    },
    {
      "id": "macros",
      "implementation_owner": "B.P3",
      "contract": "docs/plans/phase-b/target-bridge-api.md",
      "transport": "rust_macro_expansion",
      "operations": [
        "trace!",
        "debug!",
        "info!",
        "warn!",
        "error!",
        "event!",
        "#[instrument]"
      ],
      "result_contract": "Unit-return compatibility with bounded failure accounting",
      "invariants": [
        "consumer_depends_on_bridge_only",
        "nonfatal_nonrecursive"
      ]
    },
    {
      "id": "neutral_typed_errors",
      "implementation_owner": "B.1a",
      "contract": "docs/plans/phase-b/error-api-contract.md",
      "transport": "native_rust",
      "operations": [
        "ClassifiedError",
        "IdentityFailure",
        "InitFailure",
        "EventFailure",
        "FlushFailure",
        "ShutdownFailure",
        "ProjectionFailure",
        "SubscriberFailure",
