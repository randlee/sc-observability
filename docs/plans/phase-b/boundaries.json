        "TypedProcessIdentityResolver",
        "TypedObservationSubscriber",
        "TypedLogProjector",
        "TypedSpanProjector",
        "TypedMetricProjector",
        "legacy_identity",
        "typed_identity",
        "legacy_subscriber",
        "typed_subscriber",
        "legacy_log_projector",
        "typed_log_projector",
        "legacy_span_projector",
        "typed_span_projector",
        "legacy_metric_projector",
        "typed_metric_projector"
      ],
      "result_contract": "Typed failures preserving original boxed ErrorContext",
      "invariants": [
        "published_types_unchanged",
        "typed_traits_not_root_reexported",
        "no_blanket_overlap"
      ]
    },
    {
      "id": "typed_logger",
      "implementation_owner": "B.1b",
      "contract": "docs/plans/phase-b/sprint-b-1b-logger-errors.md",
