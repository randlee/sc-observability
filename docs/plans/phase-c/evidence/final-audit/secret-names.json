{
  "repository": {
    "command": [
      "gh",
      "secret",
      "list",
      "--repo",
      "randlee/sc-observability",
      "--json",
      "name"
    ],
    "names": [
      {
        "name": "CARGO_REGISTRY_TOKEN"
      },
      {
        "name": "WINGET_GITHUB_TOKEN"
      }
    ]
  },
  "npm": {
    "command": [
      "gh",
      "secret",
      "list",
      "--repo",
      "randlee/sc-observability",
      "--json",
      "name",
      "--env",
      "npm"
    ],
    "names": [
      {
        "name": "NPM_TOKEN"
      }
    ]
  },
  "pypi": {
    "command": [
      "gh",
      "secret",
      "list",
      "--repo",
      "randlee/sc-observability",
      "--json",
      "name",
      "--env",
      "pypi"
    ],
    "names": [
      {
        "name": "PYPI_API_TOKEN"
      }
    ]
  },
  "testpypi": {
    "command": [
      "gh",
      "secret",
      "list",
      "--repo",
      "randlee/sc-observability",
      "--json",
      "name",
      "--env",
      "testpypi"
    ],
    "names": [
      {
        "name": "TEST_PYPI_API_TOKEN"
      }
    ]
  }
}
