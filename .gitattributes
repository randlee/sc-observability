# Canonical generated binding artifacts are LF text. Keeping checkout bytes
# stable makes every generator's --check mode enforce the same exact output.
bindings/schema/*.json text eol=lf
bindings/python/sc-observability-py/python/sc_observability/generated/** text eol=lf
bindings/typescript/src/generated/** text eol=lf
bindings/tauri/permissions/autogenerated/** text eol=lf
bindings/tauri/permissions/schemas/*.json text eol=lf

# Immutable history compares checkout bytes with Git blobs on every platform.
schema/api/** text eol=lf
crates/sc-observability-otlp/src/durable/schema.sql text eol=lf
crates/sc-observability-otlp/src/durable/tests/fixtures/schema-v1.sql text eol=lf

# Generated sc-otel manual: cli_docs::generated_manual_is_current compares exact bytes.
docs/manual/sc-otel/** text eol=lf
site/manual/sc-otel/** text eol=lf
crates/sc-otel-cli/src/manual.txt text eol=lf
schema/cli/sc-otel/** text eol=lf
