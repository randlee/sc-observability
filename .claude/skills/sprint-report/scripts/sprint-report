#!/usr/bin/env python3
"""Render a sprint report from the committed index and live beads/PRs."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


def run_json(repo: Path, *args: str) -> Any:
    result = subprocess.run(
        list(args), cwd=repo, check=False, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, text=True,
    )
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(f"{' '.join(args)} failed: {detail}")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"{' '.join(args)} returned invalid JSON: {exc}") from exc


def edge_id(edge: dict[str, Any]) -> str:
    return str(edge.get("depends_on_id") or edge.get("id") or "")


def edge_type(edge: dict[str, Any]) -> str:
    return str(edge.get("type") or edge.get("dependency_type") or "")


def metadata(bead: dict[str, Any]) -> dict[str, Any]:
    value = bead.get("metadata")
    return value if isinstance(value, dict) else {}


def related_bead(bead: dict[str, Any], target: str, relation: str) -> bool:
    return any(edge_id(edge) == target and edge_type(edge) == relation
               for edge in bead.get("dependencies") or [])


def choose_round(candidates: list[dict[str, Any]]) -> dict[str, Any] | None:
    if not candidates:
        return None
    return max(
        candidates,
        key=lambda bead: (
            int(str(metadata(bead).get("round", "0")))
            if str(metadata(bead).get("round", "0")).isdigit() else 0,
            str(bead.get("id", "")),
        ),
    )


def status_icon(dev: dict[str, Any], sanity: dict[str, Any] | None) -> str:
    if sanity is None:
        return "🚩 no sanity bead"
    statuses = {str(dev.get("status", "")), str(sanity.get("status", ""))}
    if "blocked" in statuses:
        return "🚧"
    if "in_progress" in statuses:
        return "🌀"
    if statuses == {"closed"}:
        return "✅"
    return "📥"


def qa_summary(qa: dict[str, Any] | None, findings: list[dict[str, Any]]) -> str:
    if not qa:
        return "not dispatched"
    qa_meta = metadata(qa)
    round_number = qa_meta.get("round") or "?"
    verdict = str(qa_meta.get("verdict") or "").upper()
    if not verdict:
        close_reason = str(qa.get("close_reason") or "")
        verdict = close_reason.split(":", 1)[0].strip().upper()
    if verdict not in {"PASS", "FAIL"}:
        verdict = "IN PROGRESS" if qa.get("status") != "closed" else "UNKNOWN"
    open_findings = sum(1 for finding in findings if finding.get("status") != "closed")
    return f"R{round_number} {verdict} ({open_findings} open)"


def check_icon(pr: dict[str, Any] | None) -> str:
    if not pr:
        return "—"
    if pr.get("mergedAt") or str(pr.get("state", "")).upper() == "MERGED":
        return "🏁"
    checks = pr.get("statusCheckRollup") or []
    conclusions = {
        str(check.get("conclusion") or check.get("state") or "").upper()
        for check in checks
    }
    if conclusions & {"FAILURE", "CANCELLED", "ERROR", "TIMED_OUT", "ACTION_REQUIRED"}:
        return "❌"
    if not checks or conclusions & {
        "EXPECTED", "PENDING", "QUEUED", "IN_PROGRESS", "REQUESTED", "WAITING"
    }:
        return "🌀"
    return "✅"


def select_pr(prs: list[dict[str, Any]], head: str | None) -> dict[str, Any] | None:
    if not head:
        return None
    matches = [pr for pr in prs if pr.get("headRefName") == head]
    return max(
        matches,
        key=lambda pr: (
            str(pr.get("state", "")).upper() != "OPEN",
            int(pr.get("number", 0)),
        ),
    ) if matches else None


def index_path(repo: Path, root: str) -> Path:
    helper = repo / ".claude/skills/atm-beads/scripts/phase-index-path"
    return Path(subprocess.check_output([str(helper), "--root", root], text=True).strip())


def load_index(repo: Path, explicit: Path | None, root: str | None) -> tuple[Path, dict[str, Any]]:
    if explicit:
        path = explicit if explicit.is_absolute() else repo / explicit
    elif root:
        path = index_path(repo, root)
    else:
        candidates = sorted((repo / "docs" / "plans").glob("phase-*/sprints.json"))
        if len(candidates) != 1:
            raise RuntimeError("pass --root or --index; no unique phase sprint index found")
        path = candidates[0]
    if not path.exists():
        raise RuntimeError(f"sprint index not found: {path}")
    try:
        return path, json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid sprint index {path}: {exc}") from exc


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--table", action="store_true", help="render the compact table (default)")
    mode.add_argument("--detailed", action="store_true", help="render detailed sprint blocks")
    parser.add_argument("--root", help="phase root bead id")
    parser.add_argument("--index", type=Path, help="committed sprints.json path")
    args = parser.parse_args()

    try:
        repo = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
        _, index = load_index(repo, args.index, args.root)
        rows = index.get("sprints")
        if not isinstance(rows, list) or not rows:
            raise RuntimeError("sprint index contains no sprints")
        row_ids = [row["id"] for row in rows]
        all_beads = run_json(repo, "bd", "list", "--all", "-n", "0", "--json")
        dev_ids = set(row_ids)
        sanity_by_dev: dict[str, dict[str, Any]] = {}
        qa_by_dev: dict[str, list[dict[str, Any]]] = {}
        for bead in all_beads:
            for dev_id in dev_ids:
                if "stage:dev-sanity" in (bead.get("labels") or []) and related_bead(bead, dev_id, "blocks"):
                    sanity_by_dev[dev_id] = bead
                if related_bead(bead, dev_id, "validates"):
                    qa_by_dev.setdefault(dev_id, []).append(bead)
        selected_qa = {dev_id: choose_round(candidates) for dev_id, candidates in qa_by_dev.items()}
        related_ids = row_ids + [str(bead["id"]) for bead in sanity_by_dev.values()] + [
            str(qa["id"]) for qa in selected_qa.values() if qa
        ]
        live = run_json(repo, "bd", "show", *dict.fromkeys(related_ids), "--json")
        live_by_id = {str(bead.get("id")): bead for bead in live}
        prs = run_json(
            repo, "gh", "pr", "list", "--state", "all", "--limit", "1000",
            "--json", "number,state,isDraft,mergedAt,statusCheckRollup,headRefName,baseRefName,title",
        )
    except (OSError, RuntimeError, subprocess.CalledProcessError, json.JSONDecodeError, KeyError, TypeError, ValueError) as exc:
        print(f"sprint-report: {exc}", file=sys.stderr)
        return 2

    sprint_by_id = {str(row["id"]): row.get("sprint", row["id"]) for row in rows}
    table_rows: list[str] = []
    detailed_rows: list[str] = []
    for row in rows:
        dev_id = str(row["id"])
        dev = live_by_id.get(dev_id, {})
        sanity_id = sanity_by_dev.get(dev_id, {}).get("id")
        sanity = live_by_id.get(str(sanity_id)) if sanity_id else None
        qa = live_by_id.get(str(selected_qa.get(dev_id, {}).get("id"))) if selected_qa.get(dev_id) else None
        findings = [
            bead for bead in all_beads
            if qa and (
                related_bead(bead, str(qa["id"]), "discovered-from")
                or related_bead(bead, str(qa["id"]), "parent-child")
            )
        ]
        folded_into = row.get("folded_into")
        folded_text = f"folded → {sprint_by_id.get(str(folded_into), folded_into)}" if folded_into else None
        dev_cell = folded_text or status_icon(dev, sanity)
        qa_cell = folded_text or qa_summary(qa, findings)
        pr = select_pr(prs, metadata(dev).get("branch"))
        pr_cell = f"#{pr['number']}" if pr else "—"
        ci_cell = folded_text or check_icon(pr)
        table_rows.append(f"| {row['sprint']} | {dev_cell} | {qa_cell} | {ci_cell} | {pr_cell} |")
        detailed_rows.append("\n".join([
            f"Sprint: {row['sprint']}  {row.get('title', '')}",
            f"DEV: {dev_cell} ({dev.get('status', 'unknown')})",
            f"QA: {qa_cell}",
            f"CI: {ci_cell}",
            f"PR: {pr_cell}",
        ]))

    integration_branch = index.get("integration_branch")
    integration_pr = select_pr(prs, integration_branch)
    integration_pr_cell = f"#{integration_pr['number']}" if integration_pr else "—"
    integration_row = (
        f"| **{integration_branch or 'integration'}** | | — | {check_icon(integration_pr)} | "
        f"{integration_pr_cell} |"
    )
    detailed_integration = (
        f"Integration: {integration_branch or 'integration'} → develop\n"
        f"CI: {check_icon(integration_pr)}\nPR: {integration_pr_cell}"
    )
    variables = {
        "mode": "detailed" if args.detailed else "table",
        "sprint_rows": "\n\n".join(detailed_rows) if args.detailed else "\n".join(table_rows),
        "integration_row": detailed_integration if args.detailed else integration_row,
    }
    with tempfile.TemporaryDirectory(prefix="sprint-report-") as temp_dir:
        var_file = Path(temp_dir) / "report.json"
        var_file.write_text(json.dumps(variables, indent=2) + "\n", encoding="utf-8")
        rendered = subprocess.run(
            ["sc-compose", "render", "--file", str(repo / ".claude/skills/sprint-report/report.md.j2"),
             "--var-file", str(var_file)],
            cwd=repo, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    if rendered.returncode:
        print(rendered.stderr, file=sys.stderr, end="")
        return rendered.returncode
    print(rendered.stdout, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
