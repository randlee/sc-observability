#!/usr/bin/env python3
"""Render a sprint report from the committed index and live beads/PRs."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


def run_json(repo: Path, *args: str) -> Any:
    result = subprocess.run(
        list(args),
        cwd=repo,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(f"{' '.join(args)} failed: {detail}")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"{' '.join(args)} returned invalid JSON: {exc}") from exc


def status_icon(status: str, *, sanity: str | None = None) -> str:
    if status == "closed" and (sanity in (None, "closed")):
        return "✅"
    if status in {"in_progress", "blocked"} or sanity in {"in_progress", "blocked"}:
        return "🌀" if status != "blocked" and sanity != "blocked" else "🚧"
    return "📥"


def qa_summary(qa: dict[str, Any] | None, findings: list[dict[str, Any]]) -> str:
    if not qa:
        return "not dispatched"
    metadata = qa.get("metadata") or {}
    round_number = metadata.get("round") or "?"
    qa_id = str(qa.get("id", ""))
    open_findings = sum(
        1
        for finding in findings
        if str(finding.get("id", "")).startswith(f"{qa_id}-f")
        and not str(finding.get("id", "")).endswith("-sanity")
        and finding.get("status") != "closed"
    )
    close_reason = str(qa.get("close_reason") or "")
    if qa.get("status") == "closed":
        verdict = "FAIL" if open_findings or "FAIL" in close_reason.upper() else "PASS"
    else:
        verdict = "IN PROGRESS"
    return f"R{round_number} {verdict} ({open_findings} open)"


def check_icon(pr: dict[str, Any] | None) -> str:
    if not pr:
        return "—"
    if pr.get("mergedAt") or str(pr.get("state", "")).upper() == "MERGED":
        return "🏁"
    checks = pr.get("statusCheckRollup") or []
    conclusions = {
        str(check.get("conclusion") or check.get("state") or "").upper()
        for check in checks
    }
    if conclusions & {"FAILURE", "CANCELLED", "ERROR", "TIMED_OUT", "ACTION_REQUIRED"}:
        return "❌"
    if not checks or conclusions & {
        "EXPECTED",
        "PENDING",
        "QUEUED",
        "IN_PROGRESS",
        "REQUESTED",
        "WAITING",
    }:
        return "🌀"
    return "✅"


def select_pr(prs: list[dict[str, Any]], base: str | None, head: str | None) -> dict[str, Any] | None:
    matches = [
        pr
        for pr in prs
        if (not base or pr.get("baseRefName") == base)
        and (not head or pr.get("headRefName") == head)
    ]
    return max(matches, key=lambda pr: int(pr.get("number", 0))) if matches else None


def load_index(repo: Path, explicit: Path | None, root: str | None) -> tuple[Path, dict[str, Any]]:
    if explicit:
        path = explicit if explicit.is_absolute() else repo / explicit
    elif root:
        root_record = run_json(repo, "bd", "show", root, "--json")[0]
        phase = (root_record.get("metadata") or {}).get("phase")
        if not phase:
            raise RuntimeError(f"root bead {root} has no metadata.phase")
        path = repo / "docs" / "plans" / f"phase-{phase}" / "sprints.json"
    else:
        preferred = repo / "docs" / "plans" / "phase-d" / "sprints.json"
        candidates = sorted((repo / "docs" / "plans").glob("phase-*/sprints.json"))
        path = preferred if preferred.exists() else (candidates[-1] if len(candidates) == 1 else None)
        if path is None:
            raise RuntimeError("pass --root or --index; no unique phase sprint index found")
    if not path.exists():
        raise RuntimeError(f"sprint index not found: {path}")
    return path, json.loads(path.read_text(encoding="utf-8"))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--table", action="store_true", help="render the compact table (default)")
    mode.add_argument("--detailed", action="store_true", help="render detailed sprint blocks")
    parser.add_argument("--root", help="phase root bead id")
    parser.add_argument("--index", type=Path, help="committed sprints.json path")
    args = parser.parse_args()

    try:
        repo = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
        _, index = load_index(repo, args.index, args.root)
        rows = index.get("sprints") or []
        ids = [row["id"] for row in rows]
        related_ids = ids + [
            value
            for row in rows
            for value in (row.get("sanity_bead"), row.get("qa_bead"))
            if value
        ]
        live = run_json(repo, "bd", "show", *dict.fromkeys(related_ids), "--json")
        live_by_id = {str(bead.get("id")): bead for bead in live}
        all_beads = run_json(repo, "bd", "list", "--all", "-n", "0", "--json")
        prs = run_json(
            repo,
            "gh",
            "pr",
            "list",
            "--state",
            "all",
            "--limit",
            "100",
            "--json",
            "number,state,isDraft,mergedAt,statusCheckRollup,headRefName,baseRefName,title",
        )
    except (OSError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"sprint-report: {exc}", file=sys.stderr)
        return 2

    table_rows: list[str] = []
    detailed_rows: list[str] = []
    for row in rows:
        dev = live_by_id.get(row["id"], {})
        sanity = live_by_id.get(row.get("sanity_bead"), {}) if row.get("sanity_bead") else None
        qa = live_by_id.get(row.get("qa_bead"), {}) if row.get("qa_bead") else None
        findings = [
            bead
            for bead in all_beads
            if qa
            and str(bead.get("id", "")).startswith(f"{qa.get('id')}-f")
        ]
        dev_meta = dev.get("metadata") or {}
        pr = select_pr(prs, row.get("pr_target"), dev_meta.get("branch"))
        dev_cell = status_icon(str(dev.get("status", "")), sanity=str((sanity or {}).get("status", "")))
        qa_cell = qa_summary(qa, findings)
        pr_cell = f"#{pr['number']}" if pr else "—"
        ci_cell = check_icon(pr)
        table_rows.append(f"| {row['sprint']} | {dev_cell} | {qa_cell} | {ci_cell} | {pr_cell} |")
        detailed_rows.append(
            "\n".join(
                [
                    f"Sprint: {row['sprint']}  {row.get('title', '')}",
                    f"DEV: {dev_cell} ({dev.get('status', 'unknown')})",
                    f"QA: {qa_cell}",
                    f"CI: {ci_cell}",
                    f"PR: {pr_cell}",
                ]
            )
        )

    integration_branch = index.get("integration_branch")
    integration_pr = select_pr(prs, "develop", integration_branch)
    integration_pr_cell = f"#{integration_pr['number']}" if integration_pr else "—"
    integration_row = (
        f"| **{integration_branch or 'integration'}** | | — | {check_icon(integration_pr)} | "
        f"{integration_pr_cell} |"
    )
    detailed_integration = (
        f"Integration: {integration_branch or 'integration'} → develop\n"
        f"CI: {check_icon(integration_pr)}\n"
        f"PR: {integration_pr_cell}"
    )
    variables = {
        "mode": "detailed" if args.detailed else "table",
        "sprint_rows": "\n".join(detailed_rows if args.detailed else table_rows),
        "integration_row": detailed_integration if args.detailed else integration_row,
    }
    with tempfile.TemporaryDirectory(prefix="sprint-report-") as temp_dir:
        var_file = Path(temp_dir) / "report.json"
        var_file.write_text(json.dumps(variables, indent=2) + "\n", encoding="utf-8")
        rendered = subprocess.run(
            [
                "sc-compose",
                "render",
                "--file",
                str(repo / ".claude/skills/sprint-report/report.md.j2"),
                "--var-file",
                str(var_file),
            ],
            cwd=repo,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    if rendered.returncode:
        print(rendered.stderr, file=sys.stderr, end="")
        return rendered.returncode
    print(rendered.stdout, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
