#!/usr/bin/env python3
"""Locate a phase's committed sprint index."""
import argparse
import subprocess
import sys
from pathlib import Path
from sprint_index_common import phase_id, phase_path, run_json


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root")
    parser.add_argument("--phase")
    args = parser.parse_args()
    if not args.root and not args.phase:
        parser.error("pass --root or --phase")
    repo = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
    # Current package uses explicit TOML locations; historical phases retain the
    # old lookup when no phase configuration is present.
    if (repo / '.atm-bd').is_dir():
        from phase_config import load, select
        try:
            config = select(repo, args.root)
        except ValueError:
            config = None
        if config is not None:
            configured_root, plan, _ = load(repo, config)
            if args.root or phase_id(configured_root, {}) == args.phase:
                print(plan)
                return
    phase = args.phase
    if args.root:
        records = run_json(repo, "bd", "show", args.root, "--json")
        if not records:
            raise RuntimeError(f"root bead not found: {args.root}")
        phase = phase_id(args.root, records[0])
    print(phase_path(repo, phase))


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError, TypeError, subprocess.CalledProcessError) as exc:
        print(f"phase-index-path: {exc}", file=sys.stderr)
        raise SystemExit(2)
