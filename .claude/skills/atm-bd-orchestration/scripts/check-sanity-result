#!/usr/bin/env bash
# Accept or reject a sanity check subagent's result envelope.
#   check-sanity-result <result.json> <sanity_bead> <dev_bead> <full commit sha>
# Exit 0 = a complete, consistent result for exactly this task; 1 = reject
# (the reason is printed); 2 = usage. The schema is sc-sanity-llm.md "Output Format".
set -uo pipefail
[ $# -eq 4 ] || { echo "usage: check-sanity-result <result.json> <sanity_bead> <dev_bead> <full sha>" >&2; exit 2; }
reason=$(jq -r --arg t "$2" --arg d "$3" --arg c "$4" '
  def str: type == "string" and length > 0;
  if .success != true then "success is not true"
  elif .error != null then "error is not null"
  elif (.data | type) != "object" then "data missing"
  else .data |
    if .sanity_bead != $t then "sanity_bead is \(.sanity_bead), expected \($t)"
    elif .dev_bead != $d then "dev_bead is \(.dev_bead), expected \($d)"
    elif .commit_checked != $c then "commit_checked is \(.commit_checked), expected \($c)"
    elif (.verdict | IN("PASS", "FAIL") | not) then "verdict is \(.verdict)"
    elif (.findings | type) != "array" then "findings is not an array"
    elif any(.findings[]; (.kind | IN("skipped", "error", "lint") | not) or (.file | str | not)
         or (.line | type != "number" or . < 1) or (.issue | str | not)) then "a finding is malformed"
    elif (.lint | type) != "object" or (.lint.command | str | not) or (.lint.exit_code | type) != "number"
      then "lint is malformed"
    elif .verdict == "PASS" and (.findings | length) > 0 then "PASS with findings"
    elif .verdict == "PASS" and .lint.exit_code != 0 then "PASS with lint exit \(.lint.exit_code)"
    elif .verdict == "FAIL" and (.findings | length) == 0 then "FAIL with no findings"
    elif .lint.exit_code != 0 and ([.findings[] | select(.kind == "lint")] | length) == 0
      then "lint exit \(.lint.exit_code) with no lint finding"
    else "ok" end
  end' "$1" 2>/dev/null) || { echo "reject: not parseable JSON"; exit 1; }
[ "$reason" = ok ] && exit 0
echo "reject: $reason"; exit 1
