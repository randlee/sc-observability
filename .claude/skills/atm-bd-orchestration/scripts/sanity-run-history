#!/usr/bin/env python3
"""Append one completed sanity run to its phase's private JSONL history.

The rendered table is deliberately separate from the completion report. This
tool keeps only presentation records in the repository's ignored ``.sc``
directory, serializes concurrent appenders, and emits the ``{"runs": [...]}`` object consumed by
``templates/sanity-run-table.md.j2``.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def fail(message: str) -> None:
    raise SystemExit(f"sanity-run-history: {message}")


def parse_vars(path: Path) -> dict[str, object]:
    try:
        record = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read completion vars {path}: {exc}")
    if not isinstance(record, dict):
        fail("completion vars must be a JSON object")

    required = {
        "sprint": str,
        "verdict": str,
        "findings_count": int,
    }
    for field, expected in required.items():
        value = record.get(field)
        if isinstance(value, bool) or not isinstance(value, expected):
            fail(f"completion vars.{field} must be {expected}")
    if record["findings_count"] < 0:
        fail("completion vars.findings_count cannot be negative")
    if record["verdict"] not in {"PASS", "FAIL"}:
        fail("completion vars.verdict must be PASS or FAIL")
    return record


def normalize_phase(value: str) -> str | None:
    match = re.fullmatch(r"(?:phase-)?([a-z][a-z0-9_-]*)", value.lower())
    return match.group(1) if match else None


def phase_from_sprint(sprint: str) -> str:
    match = re.fullmatch(r"(?:phase-)?([a-z]+)(?:[-_]?\d+)?", sprint.lower())
    if not match:
        fail(f"cannot derive a phase from sprint {sprint!r}")
    return match.group(1)


def phase_from_bead(bead: str, sprint: str) -> str:
    try:
        completed = subprocess.run(
            ["bd", "show", bead, "--json"],
            check=True,
            capture_output=True,
            text=True,
        )
        issues = json.loads(completed.stdout)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        issues = []
    if isinstance(issues, list) and issues and isinstance(issues[0], dict):
        metadata = issues[0].get("metadata")
        phase = metadata.get("phase") if isinstance(metadata, dict) else None
        if isinstance(phase, str) and (normalized := normalize_phase(phase)):
            return normalized
    return phase_from_sprint(sprint)


def primary_repository_root() -> Path:
    try:
        completed = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        fail(f"cannot locate repository common directory: {exc}")
    return Path(completed.stdout.strip()).parent


def load_log(path: Path) -> list[dict[str, object]]:
    if not path.exists():
        return []
    runs = []
    try:
        lines = path.read_text().splitlines()
        for line_number, line in enumerate(lines, start=1):
            if not line.strip():
                continue
            try:
                run = json.loads(line)
            except json.JSONDecodeError as exc:
                if line_number == len(lines):
                    print(f"sanity-run-history: skipping truncated final line in {path}: {exc}", file=sys.stderr)
                    continue
                raise
            if not isinstance(run, dict):
                fail(f"log {path}:{line_number} is not a JSON object")
            runs.append(run)
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read log {path}: {exc}")
    return runs


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--vars", required=True, type=Path,
                        help="completed dev-sanity vars JSON")
    parser.add_argument("--task", required=True)
    parser.add_argument("--bead", required=True, help="checked dev or finding bead")
    parser.add_argument("--pr-number", required=True, type=int)
    parser.add_argument("--iteration", required=True, type=int)
    parser.add_argument("--started-at", required=True, type=float)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--limit", type=int, default=6)
    args = parser.parse_args()
    if args.limit < 0:
        fail("--limit must be zero (all) or positive")

    if args.pr_number < 1 or args.iteration < 1:
        fail("--pr-number and --iteration must be positive")
    vars = parse_vars(args.vars)
    completed = datetime.now(timezone.utc)
    elapsed_seconds = max(0, round(completed.timestamp() - args.started_at))
    phase = phase_from_bead(args.bead, vars["sprint"])
    record = {
        "task": args.task,
        "sprint": vars["sprint"],
        "phase": phase,
        "pr_number": args.pr_number,
        "findings": vars["findings_count"],
        "verdict": vars["verdict"],
        "iteration": args.iteration,
        "completed_at": completed.isoformat().replace("+00:00", "Z"),
        "completed_local": completed.astimezone().strftime("%H:%M"),
        "duration": f"{elapsed_seconds // 60}m{elapsed_seconds % 60:02d}s",
    }

    log_path = primary_repository_root() / ".sc" / "sanity-log" / f"phase-{phase}.jsonl"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = log_path.with_suffix(log_path.suffix + ".lock")
    with lock_path.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        runs = load_log(log_path)
        with log_path.open("a", encoding="utf-8") as log:
            log.write(json.dumps(record, sort_keys=True) + "\n")
            log.flush()
            os.fsync(log.fileno())
        runs.append(record)
        newest_first = list(reversed(runs if args.limit == 0 else runs[-args.limit:]))
        render_vars = {"runs": newest_first}
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(json.dumps(render_vars, indent=2, sort_keys=True) + "\n")
        fcntl.flock(lock, fcntl.LOCK_UN)


if __name__ == "__main__":
    main()
