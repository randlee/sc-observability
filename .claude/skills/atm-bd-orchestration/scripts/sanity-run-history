#!/usr/bin/env python3
"""Append one completed sanity run to a shared JSON history.

The rendered table is deliberately separate from the completion report.  This
tool keeps only presentation records outside a worktree, serializes concurrent
appenders, and emits the ``{"runs": [...]}`` object consumed by
``templates/sanity-run-table.md.j2``.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
from datetime import datetime, timezone
from pathlib import Path
from tempfile import NamedTemporaryFile


def fail(message: str) -> None:
    raise SystemExit(f"sanity-run-history: {message}")


def parse_record(path: Path) -> dict[str, object]:
    try:
        record = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read record {path}: {exc}")
    if not isinstance(record, dict):
        fail("record must be a JSON object")

    required = {
        "task": str,
        "sprint": str,
        "pr_number": int,
        "findings": int,
        "verdict": str,
        "iteration": int,
        "started_at": (int, float),
    }
    for field, expected in required.items():
        value = record.get(field)
        if isinstance(value, bool) or not isinstance(value, expected):
            fail(f"record.{field} must be {expected}")
    if record["pr_number"] < 1 or record["findings"] < 0 or record["iteration"] < 1:
        fail("pr_number and iteration must be positive; findings cannot be negative")
    if record["verdict"] not in {"PASS", "FAIL"}:
        fail("record.verdict must be PASS or FAIL")
    return record


def default_state() -> Path:
    base = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    return base / "sc-observability" / "sanity-runs.json"


def load_state(path: Path) -> list[dict[str, object]]:
    if not path.exists():
        return []
    try:
        content = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read state {path}: {exc}")
    runs = content.get("runs") if isinstance(content, dict) else None
    if not isinstance(runs, list) or not all(isinstance(run, dict) for run in runs):
        fail(f"state {path} does not contain a runs array")
    return runs


def write_json_atomic(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as temporary:
        json.dump(value, temporary, indent=2, sort_keys=True)
        temporary.write("\n")
        temporary_path = Path(temporary.name)
    temporary_path.replace(path)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--record-file", required=True, type=Path)
    parser.add_argument("--state", type=Path, default=default_state())
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--limit", type=int, default=6)
    args = parser.parse_args()
    if args.limit < 1:
        fail("--limit must be positive")

    record = parse_record(args.record_file)
    completed = datetime.now(timezone.utc)
    elapsed_seconds = max(0, round(completed.timestamp() - float(record["started_at"])))
    record.update(
        completed_at=completed.isoformat().replace("+00:00", "Z"),
        completed_local=completed.astimezone().strftime("%H:%M"),
        duration=f"{elapsed_seconds // 60}m{elapsed_seconds % 60:02d}s",
    )

    args.state.parent.mkdir(parents=True, exist_ok=True)
    lock_path = args.state.with_suffix(args.state.suffix + ".lock")
    with lock_path.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        runs = load_state(args.state)
        key = (record["task"], record["iteration"])
        runs = [run for run in runs if (run.get("task"), run.get("iteration")) != key]
        runs.append(record)
        runs.sort(key=lambda run: str(run["completed_at"]), reverse=True)
        write_json_atomic(args.state, {"runs": runs})
        render_vars = {"runs": runs[: args.limit]}
        write_json_atomic(args.output, render_vars)
        fcntl.flock(lock, fcntl.LOCK_UN)


if __name__ == "__main__":
    main()
