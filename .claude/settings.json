{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Edit(**/.claude/skills/atm-beads/scripts/**)",
      "Edit(**/.claude/skills/atm-beads/schemas/**)",
      "Edit(**/.claude/skills/atm-bd-orchestration/scripts/**)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/hooks/**)",
      "Write(**/.claude/skills/atm-beads/scripts/**)",
      "Write(**/.claude/skills/atm-beads/schemas/**)",
      "Write(**/.claude/skills/atm-bd-orchestration/scripts/**)",
      "Write(**/.claude/settings.json)",
      "Write(**/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-validators.sh" }]
      }
    ]
  },
  "enabledPlugins": {
    "sc-git-worktree@synaptic-canvas": true
  }
}
